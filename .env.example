# ─────────────────────────────────────────────────────────────
# RingCX QA Platform — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
# Public URL of the API, used by the web app
VITE_API_URL=http://localhost:4000
# Comma-separated allowed origins for CORS. Leave unset in local dev (allows
# all). In production, set to your Vercel domain, e.g:
# CORS_ORIGIN=https://ringcx-qa.vercel.app
CORS_ORIGIN=

# --- Auth (app users) ---
# Generate a long random string, e.g: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Database (Postgres) ---
# Runtime connection. On Supabase use the POOLED url (port 6543) + ?pgbouncer=true.
DATABASE_URL=postgresql://qa:qa@localhost:5432/qa?schema=public
# Direct connection for migrations (Supabase: port 5432). For local/Neon,
# set this to the SAME value as DATABASE_URL.
DIRECT_URL=postgresql://qa:qa@localhost:5432/qa?schema=public

# --- Redis (BullMQ queues) ---
# Leave unset until the worker is deployed (e.g. via Upstash) — its absence
# is what makes the API's /pipeline routes correctly report "not configured"
# instead of hanging. Local worker dev: redis://localhost:6379 (docker-compose).
REDIS_URL=

# --- Object storage (S3-compatible; MinIO for local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=recordings
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Set true for MinIO / path-style S3
S3_FORCE_PATH_STYLE=true

# --- Supabase Storage (direct large-file uploads) ---
# From your Supabase project: Settings → API. The service role key is secret
# (API only, never the browser). The web app uses VITE_SUPABASE_URL +
# VITE_SUPABASE_ANON_KEY (the anon key is safe to expose).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECORDINGS_BUCKET=recordings

# --- RingCX / RingCentral (Phase 2) ---
# Recording API access must be manually enabled by your RingCentral rep.
# App must have the ReadAccounts OAuth scope.
RC_SERVER_URL=https://platform.ringcentral.com
RC_ENGAGE_URL=https://engage.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_ACCOUNT_ID=
RC_SUBACCOUNT_ID=
# Lag (minutes) after a call ends before we try to pull its recording.
RC_INGEST_LAG_MINUTES=15
# Percentage (0-100) of calls to sample for QA scoring.
QA_SAMPLE_PERCENT=20

# --- AssemblyAI (Phase 3) ---
ASSEMBLYAI_API_KEY=

# --- Claude / Anthropic (Phase 4) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
